{
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "deny": [
      "Bash(/bin/rm *)",
      "Bash(/usr/bin/git clean *)",
      "Bash(/usr/bin/git reset --hard *)",
      "Bash(/usr/bin/git rm *)",
      "Bash(/usr/bin/truncate *)",
      "Bash(git clean *)",
      "Bash(git reset --hard *)",
      "Bash(git rm *)",
      "Bash(rm *)",
      "Bash(truncate *)",
      "Edit(**/*.key)",
      "Edit(**/*.pem)",
      "Edit(**/.env)",
      "Edit(**/.env.*)",
      "Edit(**/.ssh/**)",
      "Edit(~/.ssh/**)",
      "Read(**/*.key)",
      "Read(**/*.pem)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/.ssh/**)",
      "Read(~/.ssh/**)"
    ],
    "ask": [
      "Bash(git restore *)",
      "Bash(/usr/bin/git restore *)",
      "Bash(rsync *)",
      "Bash(/usr/bin/rsync *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/deny-secret-paths.sh",
            "timeout": 10,
            "statusMessage": "Checking command for secret file paths"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "sh ~/.claude/statusline.sh",
    "padding": 0
  },
  "enabledPlugins": {
    "cc-plugin-agents-md@builtin": true,
    "cc-plugin-diff@builtin": true
  },
  "extraKnownMarketplaces": {},
  "theme": "dark",
  "autoMode": {
    "environment": [
      "### Org-wide",
      "**Organization**: None configured",
      "**Cloud provider(s)**: None configured",
      "**Internal sharing / snippet hosting**: None configured — treat public paste/gist services as outside the trust boundary",
      "**Secrets management**: None configured",
      "**Default / protected branches**: default branch unknown (origin/HEAD unset); no rulesets or protected branches listed via gh",
      "**CI/CD deploy targets**: None configured",
      "**Network posture**: None configured",
      "**Host containment**: None configured — assume Claude Code runs on an ordinary developer machine or CI runner with open internet",
      "**Trusted internal domains**: None configured",
      "**Trusted cloud buckets**: None configured",
      "**Key internal services**: None configured",
      "**Internal package registry**: None configured",
      "**Sensitive data locations & audiences**: any file or store holding personal data, confidential business data, credentials, regulated data, or similarly sensitive material; preserve exact handles when known and share only with audiences cleared at the [named+specifics] bar; note repo contains common/.claude/hooks/deny-secret-paths.sh suggesting dotfiles secrets hygiene is already a local concern",
      "**Data retention / declassification**: None configured",
      "**Sensitive remote targets**: any namespace, host, or container whose name carries `prod` or `production` as a whole word or name segment",
      "**Protected deployment namespaces / environments**: None configured — fall back to the Sensitive remote targets heuristic",
      "**Protected IaC scopes**: IAM, RBAC, networking, quota, and node-pool resources; anything whose name or tag carries `prod` or `production` as a whole word or name segment",
      "### User-specific",
      "**Org-specific CLIs**: None configured"
    ]
  }
}
